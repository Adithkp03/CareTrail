# Local dev defaults to SQLite. For Supabase, use the Postgres connection string
# from Supabase -> Project Settings -> Database (URI format).
DATABASE_URL=sqlite:///./caretrail.db
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Supabase Auth verifier. Use your trusted project origin for ES256/RS256 JWKS
# and issuer checking. A legacy HS256 project also needs its JWT secret here.
SUPABASE_URL=
