<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds only: makes androidx.activity.ComponentActivity resolvable
         so Compose UI tests (Roborazzi screenshots under Robolectric) can launch
         it. Merged into the debug manifest that unit tests see when
         unitTests.isIncludeAndroidResources is on. Not in release builds.
         No LAUNCHER intent-filter here: a launcher entry ships a second
         "CareTrail" home-screen icon in installed debug builds. -->
    <application>
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true" />
    </application>
</manifest>
